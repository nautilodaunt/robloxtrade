{
  "manifest_version": 3,
  "name": "Roblox Trade Assistant",
  "version": "0.8.0",
  "minimum_chrome_version": "110",
  "incognito": "not_allowed",
  "description": "Display trade values and value-change odds, browse limiteds by raise odds, analyze portfolio risk, find value-gain trade ads, schedule trade ads, and mass send reviewed trades.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://api.rolimons.com/*",
    "https://trades.roblox.com/*",
    "https://users.roblox.com/*",
    "https://www.rolimons.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://web.roblox.com/*"
      ],
      "js": [
        "src/values.js",
        "src/item-insights.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.rolimons.com/*"
      ],
      "js": [
        "src/rolimons-ads-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Trade Assistant status",
    "default_popup": "src/popup.html"
  }
}
